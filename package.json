{
  "name": "adam",
  "private": true,
  "version": "0.0.0",
  "description": "Remote control platform for AI coding agents.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check": "node scripts/check-docs.mjs",
    "daemon:build": "npm run build --workspace @adam/daemon",
    "daemon:test": "npm run test --workspace @adam/daemon",
    "daemon:health": "npm run health --workspace @adam/daemon --",
    "relay:build": "npm run build --workspace @adam/relay",
    "relay:test": "npm run test --workspace @adam/relay",
    "relay:start": "npm run start --workspace @adam/relay --",
    "ci": "npm run check && npm run daemon:test && npm run daemon:build && npm run relay:test && npm run relay:build"
  },
  "devDependencies": {
    "@types/node": "^20.17.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
